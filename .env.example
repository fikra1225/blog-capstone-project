# Copy this file to .env and fill in your PostgreSQL credentials.
# Never commit the real .env file to version control.

# Option 1 — a single connection URL (recommended):
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME

# Option 2 — individual vars (pg will pick these up automatically if DATABASE_URL is not set):
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=yourpassword
# PGDATABASE=blog_db

# Set to "true" when connecting to a hosted provider that requires SSL (e.g. Supabase, Render, Neon):
DATABASE_SSL=false

# Server port (optional, defaults to 3000):
# PORT=3000
