# Copy this file to .env and fill in your PostgreSQL credentials.
# Never commit the real .env file to version control.

# Connection URL from your cloud PostgreSQL provider (Neon, Supabase, Render, Railway, etc.)
# Examples:
#   Neon:     postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=verify-full
#   Supabase: postgresql://postgres:password@db.xxx.supabase.co:5432/postgres
#   Render:   postgresql://user:password@dpg-xxx.render.com:5432/blog_db
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME

# Set to "true" for cloud providers that require SSL (Neon, Supabase, Render, Railway):
DATABASE_SSL=true

# Set to "false" only when connecting to a local PostgreSQL instance:
# DATABASE_SSL=false

# Server port (optional, defaults to 3000):
# PORT=3000
