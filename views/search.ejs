<%- include("partials/header", { title: "Search" }) %>
      <section class="editor-page search-page">
        <a class="back-link" href="/">← Back to all posts</a>
        <div class="editor-heading">
          <p class="eyebrow">Find anything</p>
          <h1>Search posts</h1>
        </div>

        <form class="search-form" action="/search" method="GET">
          <div class="search-input-wrap">
            <input
              id="search-query"
              type="search"
              name="q"
              placeholder="Search by title, author, or content…"
              value="<%= query %>"
              autocomplete="off"
              autofocus
            />
            <button class="primary-button search-btn" type="submit">Search <span aria-hidden="true">→</span></button>
          </div>
        </form>

        <% if (query) { %>
          <div class="search-results-header">
            <% if (posts.length === 0) { %>
              <p class="search-no-results">No posts found for "<strong><%= query %></strong>". Try different keywords.</p>
            <% } else { %>
              <p class="search-count"><%= posts.length %> result<%= posts.length === 1 ? '' : 's' %> for "<strong><%= query %></strong>"</p>
            <% } %>
          </div>
        <% } %>

        <div class="post-list search-post-list">
          <% posts.forEach((post) => { %>
            <article class="post-card">
              <div class="post-meta">
                <span><%= formatDate(post.created_at) %></span>
                <span class="meta-dot">·</span>
                <span>By <%= post.author %></span>
              </div>
              <h3><a class="post-title-link" href="/posts/<%= post.id %>"><%= post.title %></a></h3>
              <p><%= post.content.length > 160 ? post.content.substring(0, 160) + '…' : post.content %></p>
              <div class="post-actions">
                <a class="text-link" href="/posts/<%= post.id %>">Read post <span aria-hidden="true">→</span></a>
              </div>
            </article>
          <% }); %>
        </div>
      </section>
<%- include("partials/footer") %>
