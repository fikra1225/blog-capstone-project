<%- include("partials/header", { title: "Home" }) %>
      <section class="hero">
        <p class="eyebrow">A personal publication</p>
        <h1>Thoughts, stories,<br /><em>and useful detours.</em></h1>
        <p class="hero-copy">A quiet corner of the internet for observations, lessons, and ideas in progress.</p>
      </section>

      <div class="content-grid">
        <section id="latest" class="posts-section" aria-labelledby="latest-heading">
          <div class="section-heading">
            <div>
              <p class="eyebrow">The archive</p>
              <h2 id="latest-heading">Latest posts</h2>
            </div>
            <span class="post-count"><%= posts.length %> <%= posts.length === 1 ? "entry" : "entries" %></span>
          </div>

          <% if (posts.length === 0) { %>
            <div class="empty-state">
              <p class="empty-icon">✦</p>
              <h3>Your archive is waiting.</h3>
              <p>Write your first post and it will appear here.</p>
            </div>
          <% } %>

          <div class="post-list">
            <% posts.forEach((post) => { %>
              <article class="post-card">
                <div class="post-meta">
                  <span><%= formatDate(post.createdAt) %></span>
                  <span class="meta-dot">·</span>
                  <span>By <%= post.author %></span>
                </div>
                <h3><%= post.title %></h3>
                <p><%= post.content %></p>
              <div class="post-actions">
                <a class="text-link" href="/posts/<%= post.id %>/edit">Edit post <span aria-hidden="true">→</span></a>
                <form action="/posts/<%= post.id %>/delete" method="POST" style="margin: 0; display: inline-flex;">
                  <button type="submit" class="delete-button" aria-label="Delete post">Delete</button>
                </form>
              </div>
              </article>
            <% }); %>
          </div>
        </section>

        <aside id="write" class="form-card">
          <p class="eyebrow">Make a mark</p>
          <h2>Write a post</h2>
          <p class="form-intro">Share something you have learned, noticed, or are still figuring out.</p>
          <% if (errors.length > 0) { %>
            <div class="error-message" role="alert">
              <% errors.forEach((error) => { %><p><%= error %></p><% }); %>
            </div>
          <% } %>
          <form action="/posts" method="POST">
            <label for="title">Title</label>
            <input id="title" name="title" type="text" placeholder="Give it a good name" value="<%= formData.title %>" maxlength="120" required />
            <label for="author">Your name</label>
            <input id="author" name="author" type="text" placeholder="How should we credit you?" value="<%= formData.author %>" maxlength="60" required />
            <label for="content">Your thoughts</label>
            <textarea id="content" name="content" rows="8" placeholder="Start writing..." maxlength="5000" required><%= formData.content %></textarea>
            <button class="primary-button" type="submit">Publish post <span aria-hidden="true">↗</span></button>
          </form>
        </aside>
      </div>
<%- include("partials/footer") %>
